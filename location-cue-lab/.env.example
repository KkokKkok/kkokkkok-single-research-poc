OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: read existing PoC configuration/dependencies without copying secrets.
# KKOK_LEGACY_ROOT=C:/KKokKKok/KkokKkok-PoC
# OCR_PYTHON=absolute/path/to/python.exe
# OCR_CACHE_PATH=absolute/path/to/ocr-cache
# GROUNDING_PYTHON=absolute/path/to/python.exe
# GROUNDING_CACHE_PATH=absolute/path/to/huggingface-cache
# scripts/paper.mjs runs every stage on OPENAI_MODEL (keep it set to the current model you want).
# These optional overrides set one stage's model or reasoning effort. The paper used
#   detector gpt-4o-2024-11-20, analyzer and classifier o4-mini-2025-04-16, no reasoning effort sent;
# records store those reference values next to what was actually used (matchesPaper).
# No key at all: add --handoff <stand-in-label> to a command (see README).
# PAPER_DETECTOR_MODEL=
# PAPER_CLUEMINER_MODEL=
# PAPER_CLASSIFIER_MODEL=
# PAPER_DETECTOR_REASONING_EFFORT=
# PAPER_CLUEMINER_REASONING_EFFORT=
# PAPER_CLASSIFIER_REASONING_EFFORT=
# scripts/paper.mjs score (evaluation only) geocodes predicted addresses. NAVER Cloud Maps is the
# default: register an application with Geocoding selected and copy its two values here.
# NAVER_MAPS_CLIENT_ID=
# NAVER_MAPS_CLIENT_SECRET=
# --geocoder google uses GOOGLE_MAPS_API_KEY instead (the paper's geocoder).
# scripts/paper.mjs places (evaluation only) types texts read off a photo into NAVER place search.
# It needs a NAVER API HUB application with the local (지역) search API selected: a different
# application from the Maps one above, registered under Application Services > NAVER API HUB.
# NAVER_APIHUB_CLIENT_ID=
# NAVER_APIHUB_CLIENT_SECRET=
PORT=3210
